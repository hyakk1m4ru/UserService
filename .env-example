# PostgreSQL (postgres service + app)
POSTGRES_DB=userservice
POSTGRES_USER=user_example
POSTGRES_PASSWORD=pwd_example
POSTGRES_PORT=5432

# Application DB connection (postgres = Docker service name; for local run use localhost)
DB_URL=jdbc:postgresql://postgres:5432/userservice
DB_USERNAME=new_app_db_user
DB_PASSWORD=new_user_pwd_example

# Redis (redis = Docker service name; for local run use localhost)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=pwd_example

# Application server
SERVER_PORT=8081
